# Copy to .env and enter your real values. Never commit .env.
# Values may be unquoted, 'single quoted', or "double quoted".
# Backslashes and # inside values are literal. No interpolation is performed.
WIFI_SSID="YourHomeWiFi"
WIFI_PASSWORD="YourWiFiPassword"
PC_HOST=192.168.1.50
PC_PORT=8080
UPDATE_INTERVAL_MS=1000
DISPLAY_BRIGHTNESS=80
# START_VIEW: overview, charts, or network
START_VIEW=overview
